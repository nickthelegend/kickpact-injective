{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV"
  ],
  "globalPassThroughEnv": [
    "INJ_TESTNET_RPC_URL",
    "PRIVATE_KEY",
    "ORACLE_SIGNER_PRIVATE_KEY",
    "ORACLE_SIGNER_ADDRESS",
    "RELAYER_PRIVATE_KEY",
    "APISPORTS_KEY",
    "EXPO_PUBLIC_APISPORTS_KEY",
    "EXPO_PUBLIC_PRIVY_APP_ID",
    "EXPO_PUBLIC_PRIVY_CLIENT_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "eslint.config.*"
      ],
      "outputs": []
    },
    "format": {
      "dependsOn": [
        "^format"
      ],
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig*.json"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$"
      ],
      "outputs": []
    },
    "knip": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "knip.json"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}