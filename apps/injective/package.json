{
  "name": "kickpact-injective",
  "version": "0.0.1",
  "private": true,
  "description": "Kickpact escrow + keeper on Injective EVM (testnet, chainId 1439)",
  "scripts": {
    "build": "hardhat compile",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.ts --network inj_testnet",
    "verify": "hardhat run scripts/verify.ts --network inj_testnet",
    "settle:demo": "hardhat run scripts/settle-demo.ts --network inj_testnet",
    "typecheck": "tsc --noEmit",
    "keeper:fixtures": "bun run keeper/src/fixtures.ts",
    "keeper:sign": "bun run keeper/src/keeper.ts",
    "keeper:watch": "bun run keeper/src/keeper.ts --watch"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-network-helpers": "1.0.12",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "^22.10.0",
    "chai": "4.5.0",
    "hardhat": "^2.22.17",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5"
  }
}
