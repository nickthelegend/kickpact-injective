# Injective EVM testnet (chainId 1439). Copy to .env and fill in.

INJ_TESTNET_RPC_URL=https://k8s.testnet.json-rpc.injective.network/

# Deployer private key (0x-prefixed). Fund the address with testnet INJ.
PRIVATE_KEY=

# Oracle signer — signs match results. Keep separate from the deployer.
ORACLE_SIGNER_PRIVATE_KEY=
ORACLE_SIGNER_ADDRESS=

# API-Football key (https://dashboard.api-football.com/register). Optional —
# without it the keeper falls back to a bundled snapshot / manual score.
APISPORTS_KEY=
